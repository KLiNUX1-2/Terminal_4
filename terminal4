#!/data/data/com.termux/files/usr/bin/bash

LANG_FILE="$HOME/.terminal4_lang"
LANGUAGE="en"

if [ -f "$LANG_FILE" ]; then
    LANGUAGE=$(cat "$LANG_FILE")
fi

case "${1:-help}" in
  lang)
    case "$2" in
      en)
        echo "Language changed to English."
        echo en > "$LANG_FILE"
        ;;
      tr)
        echo "Dil Turkce olarak degistirildi."
        echo tr > "$LANG_FILE"
        ;;
      *)
        echo "Usage: edx lang [en|tr]"
        ;;
    esac
    ;;

  help)
    echo "================================"
    echo "       Terminal_4 CLI"
    echo "================================"
    echo "help       - Yardim / Help"
    echo "merhaba    - Test mesaji"
    echo "settings   - Ayarlar"
    echo "version    - Surum bilgisi"
    echo "lang       - Dil secimi"
    echo "ip         - IPv4 ve IPv6"
    echo "================================"
    ;;

  merhaba)
    echo "Merhaba! Terminal_4 hazir."
    ;;

  version)
    echo "Terminal_4 CLI version 0.1"
    ;;

  linux-ubuntu)
    echo "Ubuntu Linux baslatiliyor..."
    proot-distro login ubuntu
    ;;

  ip)
    echo "=== IPv4 ==="
    if ! curl -4 -fsS --max-time 8 https://api.ipify.org; then
      echo "IPv4 adresi alinamadi."
    else
      echo
    fi

    echo
    echo "=== IPv6 ==="
    if ! curl -6 -fsS --max-time 8 https://api6.ipify.org; then
      echo "IPv6 kullanilamiyor veya adres alinamadi."
    else
      echo
    fi
    ;;

  settings|ayarlar)
    python "$HOME/Terminal_4/TerminalMENU/View.py"
    ;;

  *)
    echo "Bilinmeyen komut. Yardim: edx help"
    ;;
esac

#!/data/data/com.termux/files/usr/bin/bash

case "$1" in
  help)
    echo "Terminal-4"
    echo "edx help"
    echo "edx merhaba"
    echo "edx oyun"
;;
  merhaba)
    echo "Terminal_4 GitHub Version 0.1 is working successfully."
    ;;
  *)
    echo "unknown command: $1"
    ;;
esac

  oyun)
    echo "========================"
    echo "      EDX MINI GAME"
    echo "========================"
    echo "1 ile 10 arasinda bir sayi tut."
    hedef=$((RANDOM % 10 + 1))
    read -r -p "Tahminin: " tahmin

    if [[ "$tahmin" =~ ^[0-9]+$ ]] && [ "$tahmin" -eq "$hedef" ]; then
      echo "Tebrikler! Dogru tahmin!"
    else
      echo "Yanlis tahmin!"
      echo "Tutulan sayi: $hedef"
    fi
    ;;
